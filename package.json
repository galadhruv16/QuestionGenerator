{
  "name": "groundq",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @groundq/web --filter @groundq/api dev",
    "build": "corepack pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r --workspace-concurrency=1 typecheck",
    "test": "corepack pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "corepack pnpm exec playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
